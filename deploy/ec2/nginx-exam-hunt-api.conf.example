# /etc/nginx/conf.d/exam-hunt-api.conf
# Use after enabling Cloudflare proxy (orange cloud) on api.techmuzzle.in
#
# Setup on EC2:
#   sudo bash deploy/cloudflare/update-cloudflare-ips.sh
#   sudo cp deploy/ec2/nginx-exam-hunt-api.conf.example /etc/nginx/conf.d/exam-hunt-api.conf
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d api.techmuzzle.in   # if not already done

include /etc/nginx/conf.d/cloudflare-real-ip.conf;

server {
    listen 80;
    server_name api.techmuzzle.in;

    include /etc/nginx/conf.d/cloudflare-allow.conf;
    deny all;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        send_timeout 900s;
    }
}

# Certbot adds listen 443 ssl. After certbot, add the same include/deny/location
# block to the SSL server { } it creates (or certbot --nginx merges this file).
