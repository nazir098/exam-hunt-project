# Copy to .env in project root (never commit .env)

# MongoDB Atlas — use Mumbai-friendly cluster region when creating Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/neetlu?retryWrites=true&w=majority

# Path to pdf-qa-extractor repo (LOCAL ADMIN ONLY — do not set on production API)
# With EXTRACTOR_ROOT mounted, localhost can: edit metadata, crop figures, publish to R2,
# and "Update student view" (Mongo). Production has no EXTRACTOR_ROOT: student GETs are
# Mongo-only (no per-request metadata/R2 enrichment). Sync content on localhost first.
EXTRACTOR_ROOT=/path/to/pdf-qa-extractor
# Optional: pdf-qa-extractor src/ for Fix LaTeX / crop-from-source bridge (defaults to $EXTRACTOR_ROOT/src)
# EXTRACTOR_SOURCE_ROOT=/path/to/pdf-qa-extractor/src

# Public CDN for question/diagram assets (R2). Use the real R2 URL even on localhost —
# never set this to http://127.0.0.1:.../files (those URLs must not be stored in Mongo).
# Local admin writes CDN URLs into Mongo so production serves them with zero sync work.
PUBLIC_FILES_BASE_URL=https://pub-e97c6c0fb4ed4d289eea27512d33293d.r2.dev
# Alias accepted by the API:
# R2_PUBLIC_BASE_URL=https://pub-e97c6c0fb4ed4d289eea27512d33293d.r2.dev
#
# Crop-from-source auto-publishes images to R2 using credentials from pdf-qa-extractor/.env:
#   R2_ENDPOINT_URL, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_PUBLIC_BASE_URL
# Keep those set so local admin crops show up on production CDN immediately.

# Optional: import manifest from extractor HTTP API instead of disk
# EXTRACTOR_MANIFEST_BASE_URL=http://127.0.0.1:8080/api/publish

# FreeLLMAPI — OpenAI-compatible
OPENAI_API_KEY=replace-with-your-llm-api-key
OPENAI_BASE_URL=https://your-llm-provider.example/v1
OPENAI_CHAT_MODEL=auto
AI_PRACTICE_ENABLED=true

# Spring (backend reads these via application.yml)
SERVER_PORT=8081

# --- Local development (put real values in .env only; never commit .env) ---
APP_DEV_MODE=true
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-local-admin-password

# Strong random secret — optional locally (default dev secret is fine)
# JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- Production deploy (set on server; do not use APP_DEV_MODE) ---
# REQUIRE_SECURE_SECRETS=true
# JWT_SECRET=<long-random-secret>
# CORS_ORIGINS=https://www.yoursite.com
# ADMIN_EMAIL=admin@yoursite.com
# ADMIN_PASSWORD=<set-once-for-first-bootstrap-only>

# Optional legacy header for curl scripts (UI uses sign-in instead)
# ADMIN_IMPORT_KEY=

# React dev server — leave unset in dev to use Vite proxy (recommended).
# VITE_API_BASE_URL=http://127.0.0.1:8081
# VITE_API_BASE_URL_FORCE=true

# Google Sign-In (disabled by default — enable when OAuth client is ready)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# Optional frontend fallback (Cloudflare Pages / when status API is unavailable)
# VITE_GOOGLE_CLIENT_ID=<same-web-client-id>
# Optional: hide Google button in UI even when backend is enabled
# VITE_GOOGLE_AUTH_ENABLED=false
