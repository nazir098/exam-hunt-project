# Copy to .env in project root (never commit .env)

# MongoDB Atlas — use Mumbai-friendly cluster region when creating Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/neetlu?retryWrites=true&w=majority

# Path to pdf-qa-extractor repo (local dev only — leave unset on production EC2)
EXTRACTOR_ROOT=/Users/nazirhusain/Projects/pdf-qa-extractor

# Production: R2 public URL for published packs (year folders live directly under this base)
# Example layout: https://pub-….r2.dev/2016/manifest.json
# Do NOT include the bucket name in the path when using r2.dev public URLs.
PUBLIC_FILES_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Optional: comma-separated year folders to import when packs-index.json is absent
# IMPORT_PACK_FOLDERS=2016,2025

# Optional: import manifest from extractor HTTP API instead of disk
# EXTRACTOR_MANIFEST_BASE_URL=http://127.0.0.1:8080/api/publish

# --- exam-hunt backend → LLMAPI (client credentials) ---
# Create the client key in the FreeLLMAPI UI (format freellmapi-...).
# Do NOT put Groq/Cerebras/OpenRouter keys here — those go on the FreeLLMAPI server.
OPENAI_API_KEY=llmapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://freellmapi-t1pm.onrender.com/v1
OPENAI_CHAT_MODEL=auto
AI_PRACTICE_ENABLED=true

# Spring (backend reads these via application.yml)
SERVER_PORT=8081

# Single admin account (bootstrap on API start; never commit real password)
ADMIN_EMAIL=hussaininazir1@gmail.com
ADMIN_PASSWORD=change-me

# Optional legacy header for curl scripts (UI uses sign-in instead)
# ADMIN_IMPORT_KEY=

# React dev server (frontend) — leave unset in dev to use Vite proxy (recommended).
# Only set if you call the API directly from the browser:
# VITE_API_BASE_URL=http://127.0.0.1:8081
# VITE_API_BASE_URL_FORCE=true

# Production examples:
# Backend CORS on EC2:
# CORS_ORIGINS=https://www.techmuzzle.in,https://exam-hunt-project.pages.dev,http://localhost:8080,http://localhost:5173
# Cloudflare Pages frontend:
# VITE_API_BASE_URL=https://api.techmuzzle.in
